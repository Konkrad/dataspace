# Registry: this repo's GHCR package, one tag per CSV,
# e.g. ghcr.io/konkrad/dataspace:S1A_20240101_COPERNICUS_catalogue_20260901
OCI_REPO=ghcr.io/konkrad/dataspace
GHCR_USER=konkrad
# Classic PAT with write:packages (and read:packages); you need write access to konkrad/dataspace
GHCR_TOKEN=

# Which satellites to process
PLATFORMS=S1A,S1B,S1C,S1D

# OData: 100 ids per request is the most that fits in the URL
ODATA_BATCH=100
ODATA_WORKERS=4
ODATA_RPS=3

# asc = oldest day first, desc = newest first
ORDER=asc
# Seconds to sleep when everything is done before checking for new CSVs
POLL_INTERVAL=21600
# 1 = exit when the list is done instead of polling
RUN_ONCE=0
LOG_LEVEL=INFO
