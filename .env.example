# Mission: sentinel-1, sentinel-2, sentinel-3 or sentinel-5p.
# docker-compose.yml sets this per service; set it here for single runs.
MISSION=sentinel-1

# Registry: one package per mission, ${OCI_BASE}/${MISSION}, one tag per CSV, e.g.
# ghcr.io/konkrad/dataspace/sentinel-1:S1A_20240101_COPERNICUS_catalogue_20260901
# (the file inside is stored as S1A/2024/01/<same name>.parquet)
OCI_BASE=ghcr.io/konkrad/dataspace
# OCI_REPO=...   # overrides ${OCI_BASE}/${MISSION} completely
GHCR_USER=konkrad
# Classic PAT with write:packages (and read:packages); you need write access to konkrad/dataspace
GHCR_TOKEN=

# Optional: only some satellites of the mission, e.g. S1C,S1D (default: all)
# PLATFORMS=

# OData: 100 ids per request is the most that fits in the URL
ODATA_BATCH=100
ODATA_WORKERS=4
ODATA_RPS=3

# asc = oldest day first, desc = newest first
ORDER=asc
# Seconds to sleep when everything is done before checking for new CSVs
POLL_INTERVAL=21600
# 1 = exit when the list is done instead of polling
RUN_ONCE=0
LOG_LEVEL=INFO
